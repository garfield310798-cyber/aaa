$btnTam.Add_Click({
    $w = 0; $h = 0
    if (-not [int]::TryParse($txtW.Text.Trim(), [ref]$w) -or $w -lt 50) { $w = 812 }
    if (-not [int]::TryParse($txtH.Text.Trim(), [ref]$h) -or $h -lt 50) { $h = 1218 }
    $script:labelW = $w
    $script:labelH = $h
    $txtW.Text = "$w"; $txtH.Text = "$h"
    Recalcular-Scale
    foreach ($el in $script:elementos) { Refresh-Control $el }
})

$cboPreset.Add_SelectedIndexChanged({
    switch ($cboPreset.SelectedItem) {
        "4x6 203" { $script:labelW = 812;  $script:labelH = 1218 }
        "4x6 300" { $script:labelW = 1200; $script:labelH = 1800 }
        "3x2 203" { $script:labelW = 609;  $script:labelH = 406 }
        "2x1 203" { $script:labelW = 406;  $script:labelH = 203 }
    }
    $txtW.Text = "$script:labelW"
    $txtH.Text = "$script:labelH"
    Recalcular-Scale
    foreach ($el in $script:elementos) { Refresh-Control $el }
})

$btnAddTexto.Add_Click({ New-Elemento "Texto" })
$btnAddBarcode.Add_Click({ New-Elemento "Barcode" })
$btnAddQR.Add_Click({ New-Elemento "QR" })

$btnEliminar.Add_Click({
    if ($script:selected -ne $null) {
        $el = $script:selected
        $script:panelCanvas.Controls.Remove($el.Ctrl)
        $script:elementos.Remove($el)
        $script:selected = $null
        Select-Elemento $null
    }
})

$btnAplicarEl.Add_Click({
    if ($script:selected -eq $null) { return }
    $el = $script:selected
    $el.Text     = $script:txtContenido.Text
    $el.Height   = [int]$script:numAltura.Value
    $el.Module   = [int]$script:numModulo.Value
    $el.ShowText = $script:chkMostrar.Checked
    Refresh-Control $el
})

$script:panelCanvas.Add_MouseDown({ Select-Elemento $null })

$btnGenerar.Add_Click({
    $script:txtZpl.Text = Generar-ZPL
    $tabs.SelectedTab = $tabEnviar
})

$btnCargar.Add_Click({
    $dlg = New-Object System.Windows.Forms.OpenFileDialog
    $dlg.Filter = "Etiquetas (*.txt;*.zpl;*.prn)|*.txt;*.zpl;*.prn|Todos (*.*)|*.*"
    if ($dlg.ShowDialog() -eq "OK") {
        $script:txtZpl.Text = [System.IO.File]::ReadAllText($dlg.FileName, $Enc)
    }
})

$btnEnviar.Add_Click({
    $ip  = $txtIp.Text.Trim()
    $zpl = $script:txtZpl.Text
    if ([string]::IsNullOrWhiteSpace($ip)) {
        [System.Windows.Forms.MessageBox]::Show("Escribe la IP de la impresora.", "Falta IP",
            [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Warning) | Out-Null
        return
    }
    if ([string]::IsNullOrWhiteSpace($zpl)) {
        [System.Windows.Forms.MessageBox]::Show("No hay ZPL. Genera el diseno o carga un .txt.", "Falta ZPL",
            [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Warning) | Out-Null
        return
    }
    $puerto = 0
    if (-not [int]::TryParse($txtPuerto.Text.Trim(), [ref]$puerto)) {
        [System.Windows.Forms.MessageBox]::Show("Puerto invalido.", "Error",
            [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Warning) | Out-Null
        return
    }
    $btnEnviar.Enabled = $false
    try {
        if ($cboMetodo.SelectedItem -eq "RAW (9100)") {
            Escribir-Log "Enviando por RAW a ${ip}:${puerto} ..."
            $r = Send-ZplRaw -ip $ip -port $puerto -zpl $zpl
        } else {
            Escribir-Log "Enviando por FTP a ${ip}:${puerto} ..."
            $r = Send-ZplFtp -ip $ip -port $puerto -zpl $zpl -passive $chkPasivo.Checked
        }
        Escribir-Log "OK -> $r"
    }
    catch {
        Escribir-Log "ERROR: $($_.Exception.Message)"
    }
    finally {
        $btnEnviar.Enabled = $true
    }
})

# ============================================================
#  INICIO
# ============================================================
Recalcular-Scale
[void]$form.ShowDialog()
