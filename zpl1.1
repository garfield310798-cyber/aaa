# Devuelve lista de modulos @{w=ancho; bar=$true/$false} para Code128 subset B
function Get-C128Modules($data) {
    $mods = New-Object System.Collections.ArrayList
    $values = New-Object System.Collections.ArrayList
    [void]$values.Add(104)            # Start B
    $weighted = 104
    $pos = 1
    foreach ($chr in ("$data").ToCharArray()) {
        $v = [int][char]$chr - 32      # subset B: ASCII 32..126 -> 0..94
        if ($v -lt 0 -or $v -gt 94) { $v = 0 }
        [void]$values.Add($v)
        $weighted += $v * $pos
        $pos++
    }
    $check = $weighted % 103           # digito de control modulo 103
    [void]$values.Add($check)
    [void]$values.Add(106)             # Stop
    $isBar = $true
    foreach ($v in $values) {
        $pat = $script:C128[$v]
        foreach ($d in $pat.ToCharArray()) {
            [void]$mods.Add(@{ w = [int]([string]$d); bar = $isBar })
            $isBar = -not $isBar
        }
    }
    return $mods
}

# ============================================================
#  ENVIO (FTP / RAW)
# ============================================================
function Send-ZplFtp {
    param([string]$ip, [int]$port, [string]$zpl, [bool]$passive)
    $uri = "ftp://${ip}:${port}/etiqueta.txt"
    $req = [System.Net.FtpWebRequest]::Create($uri)
    $req.Method      = [System.Net.WebRequestMethods+Ftp]::UploadFile
    $req.Credentials = New-Object System.Net.NetworkCredential("anonymous", "")
    $req.UseBinary   = $true
    $req.UsePassive  = $passive
    $req.KeepAlive   = $false
    $req.Timeout     = 10000
    $bytes = $Enc.GetBytes($zpl)
    $req.ContentLength = $bytes.Length
    $st = $req.GetRequestStream()
    $st.Write($bytes, 0, $bytes.Length)
    $st.Close()
    $resp = [System.Net.FtpWebResponse]$req.GetResponse()
    $estado = $resp.StatusDescription
    $resp.Close()
    return $estado.Trim()
}

function Send-ZplRaw {
    param([string]$ip, [int]$port, [string]$zpl)
    $client = New-Object System.Net.Sockets.TcpClient
    $client.Connect($ip, $port)
    $ns = $client.GetStream()
    $bytes = $Enc.GetBytes($zpl)
    $ns.Write($bytes, 0, $bytes.Length)
    $ns.Flush()
    $ns.Close()
    $client.Close()
    return "Enviado por RAW $port"
}

# ============================================================
#  EMOJI -> BITMAP MONOCROMO -> ^GFA
# ============================================================
function Emoji-ToZpl($texto, $sizeDots, $x, $y) {
    $w = [int]$sizeDots
    $h = [int]$sizeDots
    if ($w -gt 480) { $w = 480; $h = 480 }
    if ($w -lt 8)  { $w = 8;  $h = 8 }

    $bmp = New-Object System.Drawing.Bitmap $w, $h
    $g = [System.Drawing.Graphics]::FromImage($bmp)
    $g.Clear([System.Drawing.Color]::White)
    $g.TextRenderingHint = [System.Drawing.Text.TextRenderingHint]::AntiAliasGridFit
    $font = New-Object System.Drawing.Font("Segoe UI Emoji", ($h * 0.8), [System.Drawing.FontStyle]::Regular, [System.Drawing.GraphicsUnit]::Pixel)
    $sf = New-Object System.Drawing.StringFormat
    $sf.Alignment = [System.Drawing.StringAlignment]::Center
    $sf.LineAlignment = [System.Drawing.StringAlignment]::Center
    $rect = New-Object System.Drawing.RectangleF 0, 0, $w, $h
    $g.DrawString("$texto", $font, [System.Drawing.Brushes]::Black, $rect, $sf)
    $g.Dispose()
    $font.Dispose()
    $sf.Dispose()

    $bytesPerRow = [int][Math]::Ceiling($w / 8.0)
    $sb = New-Object System.Text.StringBuilder
    for ($yy = 0; $yy -lt $h; $yy++) {
        for ($bx = 0; $bx -lt $bytesPerRow; $bx++) {
            $b = 0
            for ($bit = 0; $bit -lt 8; $bit++) {
                $px = ($bx * 8) + $bit
                if ($px -lt $w) {
                    $col = $bmp.GetPixel($px, $yy)
                    $lum = ($col.R + $col.G + $col.B) / 3
                    if ($lum -lt 128) { $b = $b -bor (1 -shl (7 - $bit)) }
                }
            }
            [void]$sb.Append($b.ToString("X2"))
        }
    }
    $bmp.Dispose()
    $total = $bytesPerRow * $h
    return "^FO$x,$y^GFA,$total,$total,$bytesPerRow,$($sb.ToString())^FS"
}

# ============================================================
#  PINTADO DE PREVISUALIZACION
# ============================================================
$BarcodePaint = {
    param($s, $e)
    $g = $e.Graphics
    $g.Clear([System.Drawing.Color]::White)
    $el = $s.Tag
    $mods = Get-C128Modules "$($el.Text)"
    $modPx = [Math]::Max(1, [int][Math]::Round($el.Module * $script:scale))
    $textArea = 2
    if ($el.ShowText) { $textArea = 14 }
    $barH = $s.Height - $textArea
    if ($barH -lt 4) { $barH = 4 }
    $x = 10 * $modPx
    foreach ($m in $mods) {
        $wpx = $m.w * $modPx
        if ($m.bar) { $g.FillRectangle([System.Drawing.Brushes]::Black, $x, 0, $wpx, $barH) }
        $x += $wpx
    }
    if ($el.ShowText) {
        $f = New-Object System.Drawing.Font("Consolas", 7)
        $g.DrawString("$($el.Text)", $f, [System.Drawing.Brushes]::Black, (10 * $modPx), ($s.Height - 12))
        $f.Dispose()
    }
}

$QrPaint = {
    param($s, $e)
    $g = $e.Graphics
    $g.Clear([System.Drawing.Color]::White)
    $el = $s.Tag
    $data = "$($el.Text)"
    $n = 9
    $cell = [int]($s.Width / $n)
    if ($cell -lt 3) { $cell = 3 }
    for ($r = 0; $r -lt $n; $r++) {
        for ($c = 0; $c -lt $n; $c++) {
            $ch = 1
            if ($data.Length -gt 0) { $ch = [int][char]$data[(($r * $n) + $c) % $data.Length] }
            if ((($ch + $r + $c) % 2) -eq 0) {
                $g.FillRectangle([System.Drawing.Brushes]::Black, ($c * $cell), ($r * $cell), $cell, $cell)
            }
        }
    }
    $g.DrawRectangle([System.Drawing.Pens]::Black, 0, 0, ($cell * 3), ($cell * 3))
    $g.DrawRectangle([System.Drawing.Pens]::Black, ($s.Width - ($cell * 3) - 1), 0, ($cell * 3), ($cell * 3))
    $g.DrawRectangle([System.Drawing.Pens]::Black, 0, ($s.Height - ($cell * 3) - 1), ($cell * 3), ($cell * 3))
}

$EmojiPaint = {
    param($s, $e)
    $g = $e.Graphics
    $g.Clear([System.Drawing.Color]::White)
    $el = $s.Tag
    $sz = $s.Height
    if ($sz -lt 8) { $sz = 8 }
    $f = New-Object System.Drawing.Font("Segoe UI Emoji", ($sz * 0.8), [System.Drawing.FontStyle]::Regular, [System.Drawing.GraphicsUnit]::Pixel)
    $sf = New-Object System.Drawing.StringFormat
    $sf.Alignment = [System.Drawing.StringAlignment]::Center
    $sf.LineAlignment = [System.Drawing.StringAlignment]::Center
    $rect = New-Object System.Drawing.RectangleF 0, 0, $s.Width, $s.Height
    $g.DrawString("$($el.Text)", $f, [System.Drawing.Brushes]::Black, $rect, $sf)
    $f.Dispose()
    $sf.Dispose()
}

# ============================================================
#  ARRASTRE
# ============================================================
$OnMouseDown = {
    param($s, $e)
    $script:dragging = $true
    $script:dragOffX = $e.X
    $script:dragOffY = $e.Y
    Select-Elemento $s.Tag
}
$OnMouseMove = {
    param($s, $e)
    if ($script:dragging) {
        $nl = $s.Left + $e.X - $script:dragOffX
        $nt = $s.Top  + $e.Y - $script:dragOffY
        if ($nl -lt 0) { $nl = 0 }
        if ($nt -lt 0) { $nt = 0 }
        if ($nl -gt ($script:panelCanvas.Width  - $s.Width))  { $nl = $script:panelCanvas.Width  - $s.Width }
        if ($nt -gt ($script:panelCanvas.Height - $s.Height)) { $nt = $script:panelCanvas.Height - $s.Height }
        $el = $s.Tag
        $el.X = [int]($nl / $script:scale)
        $el.Y = [int]($nt / $script:scale)
        if ($script:snap) {
            $gd = $script:gridDots
            $el.X = [int]([Math]::Round($el.X / $gd) * $gd)
            $el.Y = [int]([Math]::Round($el.Y / $gd) * $gd)
        }
        $s.Left = [int]($el.X * $script:scale)
        $s.Top  = [int]($el.Y * $script:scale)
        $script:lblPos.Text = "X: $($el.X)  Y: $($el.Y) dots"
    }
}
$OnMouseUp = {
    param($s, $e)
    $script:dragging = $false
}

# ============================================================
#  HELPERS DE LIENZO / ELEMENTOS
# ============================================================
function Recalcular-Scale {
    $maxW = 360.0
    $maxH = 290.0
    $sx = $maxW / $script:labelW
    $sy = $maxH / $script:labelH
    $script:scale = [Math]::Min($sx, $sy)
    $script:panelCanvas.Width  = [int]($script:labelW * $script:scale)
    $script:panelCanvas.Height = [int]($script:labelH * $script:scale)
}

function Refresh-Control($el) {
    $c = $el.Ctrl
    if ($el.Type -eq "Texto") {
        $pt = [Math]::Round($el.Height * $script:scale * 0.75)
        if ($pt -lt 6) { $pt = 6 }
        $c.Font = New-Object System.Drawing.Font("Arial", $pt, [System.Drawing.FontStyle]::Bold)
        $c.Text = $el.Text
    }
    elseif ($el.Type -eq "Parrafo") {
        $pt = [Math]::Round($el.Height * $script:scale * 0.75)
        if ($pt -lt 6) { $pt = 6 }
        $bw = [int]($el.BlockW * $script:scale)
        if ($bw -lt 30) { $bw = 30 }
        $c.Font = New-Object System.Drawing.Font("Arial", $pt)
        $c.MaximumSize = New-Object System.Drawing.Size($bw, 0)
        $c.Text = $el.Text
    }
    elseif ($el.Type -eq "Barcode") {
        $mods = Get-C128Modules "$($el.Text)"
        $units = 0
        foreach ($m in $mods) { $units += $m.w }
        $modPx = [Math]::Max(1, [int][Math]::Round($el.Module * $script:scale))
        $c.Width  = ($units + 20) * $modPx
        $extra = 4
        if ($el.ShowText) { $extra = 16 }
        $c.Height = [int]($el.Height * $script:scale) + $extra
        $c.Invalidate()
    }
    elseif ($el.Type -eq "Emoji") {
        $side = [int]($el.Height * $script:scale)
        if ($side -lt 24) { $side = 24 }
        $c.Width  = $side
        $c.Height = $side
        $c.Invalidate()
    }
    else {  # QR
        $base = $el.Height
        if ($base -le 0) { $base = 100 }
        $side = [int]($base * $script:scale)
        if ($side -lt 36) { $side = 36 }
        $c.Width  = $side
        $c.Height = $side
        $c.Invalidate()
    }
    $c.Left = [int]($el.X * $script:scale)
    $c.Top  = [int]($el.Y * $script:scale)
}

function Select-Elemento($el) {
    $script:selected = $el
    foreach ($x in $script:elementos) { $x.Ctrl.BorderStyle = 'None' }
    if ($el -ne $null) {
        $el.Ctrl.BorderStyle = 'FixedSingle'
        $script:txtContenido.Text  = $el.Text
        $script:numAltura.Value    = [decimal]([Math]::Max(1, [Math]::Min(2000, $el.Height)))
        $script:numModulo.Value    = [decimal]([Math]::Max(1, [Math]::Min(10,   $el.Module)))
        $bw = 400
        if ($el.ContainsKey("BlockW")) { $bw = $el.BlockW }
        $script:numAncho.Value     = [decimal]([Math]::Max(50, [Math]::Min(2000, $bw)))
        $script:chkMostrar.Checked = [bool]$el.ShowText
        $script:lblTipoSel.Text    = "Seleccionado: $($el.Type)"
        $script:chkMostrar.Enabled = ($el.Type -eq "Barcode")
        $script:numModulo.Enabled  = ($el.Type -eq "Barcode" -or $el.Type -eq "QR")
        $script:numAncho.Enabled   = ($el.Type -eq "Parrafo")
    }
    else {
        $script:lblTipoSel.Text = "Seleccionado: (ninguno)"
    }
}

function New-Elemento($tipo) {
    $el = @{ Type = $tipo; X = 20; Y = 20; Text = ""; Height = 45; Module = 2; ShowText = $true; BlockW = 400; Ctrl = $null }
    switch ($tipo) {
        "Texto"   { $el.Text = "Texto";              $el.Height = 45 }
        "Parrafo" { $el.Text = "Linea 1`r`nLinea 2`r`nLinea 3"; $el.Height = 32; $el.BlockW = 500 }
        "Barcode" { $el.Text = "123456789";          $el.Height = 140; $el.Module = 3 }
        "QR"      { $el.Text = "https://ejemplo.com"; $el.Height = 200; $el.Module = 6 }
        "Emoji"   { $el.Text = [char]::ConvertFromUtf32(0x2B50); $el.Height = 150 }  # estrella por defecto
    }
    # Escalonar la posicion para no solapar los componentes nuevos
    $i = $script:elementos.Count
    $rangoX = [Math]::Max(40, ($script:labelW - 80))
    $rangoY = [Math]::Max(40, ($script:labelH - 80))
    $el.X = 20 + [int](($i * 25) % $rangoX)
    $el.Y = 20 + [int](($i * 40) % $rangoY)
    if ($tipo -eq "Texto" -or $tipo -eq "Parrafo") {
        $c = New-Object System.Windows.Forms.Label
        $c.AutoSize  = $true
        $c.BackColor = [System.Drawing.Color]::White
    }
    else {
        $c = New-Object System.Windows.Forms.Panel
        $c.BackColor = [System.Drawing.Color]::White
        if ($tipo -eq "Barcode") { $c.Add_Paint($BarcodePaint) }
        elseif ($tipo -eq "Emoji") { $c.Add_Paint($EmojiPaint) }
        else { $c.Add_Paint($QrPaint) }
    }
    $c.Tag = $el
    $el.Ctrl = $c
    $c.Add_MouseDown($OnMouseDown)
    $c.Add_MouseMove($OnMouseMove)
    $c.Add_MouseUp($OnMouseUp)
    $script:panelCanvas.Controls.Add($c)
    [void]$script:elementos.Add($el)
    Refresh-Control $el
    Select-Elemento $el
}

