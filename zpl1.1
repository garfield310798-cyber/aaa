# DISENADOR DE ETIQUETAS ZPL
#powershell.exe -WindowStyle Hidden -ExecutionPolicy Bypass -File "%USERPROFILE%\Desktop\zpl.ps1"
# ============================================================
# DISENADOR DE ETIQUETAS ZPL
# Texto + Parrafo (multilinea) + Code128 REAL + QR + Emoji (^GFA)
# Cuadricula de alineacion, escalonado anti-solape y limpiar todo.
# Hoja por defecto 4x6 pulgadas (203 dpi).  PowerShell 5.1, sin instalar nada.
# ============================================================

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
[System.Windows.Forms.Application]::EnableVisualStyles()

$Enc = [System.Text.Encoding]::GetEncoding(28591)   # Latin1: preserva bytes del ZPL

# ------------------------------------------------------------
#  ESTADO COMPARTIDO
# ------------------------------------------------------------
$script:elementos = New-Object System.Collections.ArrayList
$script:selected  = $null
$script:scale     = 1.0
$script:labelW    = 812      # 4" x 203dpi
$script:labelH    = 1218     # 6" x 203dpi
$script:dragging  = $false
$script:dragOffX  = 0
$script:dragOffY  = 0
$script:snap      = $false
$script:gridDots  = 20

# ------------------------------------------------------------
#  TABLA DE PATRONES CODE128 (valor 0..106 -> anchos de modulos)
# ------------------------------------------------------------
