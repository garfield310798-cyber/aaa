# ============================================================
#  GENERAR ZPL
# ============================================================
function Generar-ZPL {
    $sb = New-Object System.Text.StringBuilder
    [void]$sb.AppendLine("^XA")
    [void]$sb.AppendLine("^CI28")
    [void]$sb.AppendLine("^PW$([int]$script:labelW)")
    [void]$sb.AppendLine("^LL$([int]$script:labelH)")
    foreach ($el in $script:elementos) {
        $x = [int]$el.X
        $y = [int]$el.Y
        if ($el.Type -eq "Texto") {
            $h = [int]$el.Height
            $w = [int]($h * 0.6)
            [void]$sb.AppendLine("^FO$x,$y^A0N,$h,$w^FD$($el.Text)^FS")
        }
        elseif ($el.Type -eq "Parrafo") {
            $h = [int]$el.Height
            $w = [int]($h * 0.6)
            $bw = [int]$el.BlockW
            $body = ("$($el.Text)") -replace "`r`n", '\&' -replace "`n", '\&' -replace "`r", '\&'
            [void]$sb.AppendLine("^FO$x,$y^A0N,$h,$w^FB$bw,50,0,L,0^FD$body^FS")
        }
        elseif ($el.Type -eq "Barcode") {
            $h = [int]$el.Height
            $by = [int]$el.Module
            $line = 'N'
            if ($el.ShowText) { $line = 'Y' }
            [void]$sb.AppendLine("^FO$x,$y^BY$by^BCN,$h,$line,N,N^FD$($el.Text)^FS")
        }
        elseif ($el.Type -eq "QR") {
            $mag = [int]$el.Module
            [void]$sb.AppendLine("^FO$x,$y^BQN,2,$mag^FDQA,$($el.Text)^FS")
        }
        elseif ($el.Type -eq "Emoji") {
            [void]$sb.AppendLine((Emoji-ToZpl $el.Text $el.Height $x $y))
        }
    }
    [void]$sb.AppendLine("^XZ")
    return $sb.ToString()
}

