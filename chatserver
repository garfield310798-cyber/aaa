# ================================
# CHAT - SERVIDOR
# El servidor invita a los clientes (UDP) a que se conecten (TCP) a el.
# Los clientes escuchan pasivamente hasta recibir la invitacion.
# Retransmite los mensajes de cada cliente a todos los demas (chat grupal).
# PowerShell 5.1 compatible
# ================================

Add-Type @"
