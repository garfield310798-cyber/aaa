    void MostrarDetalle(string clave)
    {
        Registro r;
        int hIni; int[] cnt; double[] cpm; int[] est;
        string[] mHora; double[] mCpm; int[] mIdle;
        string titulo, areaTxt;
        lock (lockDatos)
        {
            if (!registros.TryGetValue(clave, out r)) return;
            r.Combinar(out hIni, out cnt, out cpm, out est);
            int n = r.MCpm.Count;
            mHora = new string[n]; mCpm = new double[n]; mIdle = new int[n];
            int j = 0;
            foreach (KeyValuePair<string, double> kv in r.MCpm)
            {
                mHora[j] = kv.Key; mCpm[j] = kv.Value;
                int id; r.MIdle.TryGetValue(kv.Key, out id); mIdle[j] = id;
                j++;
            }
            Fuente a = r.Activa();
            areaTxt = (a != null) ? a.Modo : "";
            titulo = NombreDeSinLock(r) + (r.User.Length > 0 ? "  (User " + r.User + ")" : "") + "  -  " + areaTxt;
        }

        Form f = new Form();
        f.Text = titulo;
        f.Width = 440; f.Height = 540;
        f.StartPosition = FormStartPosition.CenterParent;
        f.TopMost = true;
        f.Font = new Font("Segoe UI", 9F);
        f.BackColor = Color.White;

        TabControl tabs = new TabControl();
        tabs.Dock = DockStyle.Fill;

        // --- pestana: por hora ---
        TabPage t1 = new TabPage("Por hora");
        DataGridView g1 = NuevoGridDetalle(new string[] { "Hora", "Conteo", "CPM", "Estimado" });
        int total = 0;
        for (int i = 0; i < cnt.Length; i++)
        {
            int hora = hIni + i;
            double c = (i < cpm.Length) ? cpm[i] : 0;
            int e = (i < est.Length) ? est[i] : 0;
            g1.Rows.Add(hora.ToString("D2") + ":00", cnt[i].ToString(), c.ToString("0.0"), e.ToString());
            total += cnt[i];
        }
        Label lt = new Label();
        lt.Dock = DockStyle.Bottom; lt.Height = 32;
        lt.TextAlign = ContentAlignment.MiddleCenter;
        lt.Font = new Font("Segoe UI", 11); lt.ForeColor = Color.DimGray;
        lt.Text = "Total dia: " + total;
        t1.Controls.Add(g1);
        t1.Controls.Add(lt);

        // --- pestana: cada 2 min ---
        TabPage t2 = new TabPage("Cada 2 min");
        DataGridView g2 = NuevoGridDetalle(new string[] { "Hora", "CPM", "Inactivo" });
        for (int i = 0; i < mHora.Length; i++)
            g2.Rows.Add(mHora[i], mCpm[i].ToString("0.0"), FmtIdle(mIdle[i]));
        Label lt2 = new Label();
        lt2.Dock = DockStyle.Bottom; lt2.Height = 32;
        lt2.TextAlign = ContentAlignment.MiddleCenter;
        lt2.Font = new Font("Segoe UI", 11); lt2.ForeColor = Color.DimGray;
        lt2.Text = "Muestras: " + mHora.Length;
        t2.Controls.Add(g2);
        t2.Controls.Add(lt2);

        tabs.TabPages.Add(t1);
        tabs.TabPages.Add(t2);

        f.Controls.Add(tabs);
        f.ShowDialog(this);
    }

