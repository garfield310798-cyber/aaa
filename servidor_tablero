    // ==========================
    // UDP invitacion
    // ==========================
    void Invitar()
    {
        try
        {
            int.TryParse(txtPuertoUdp.Text.Trim(), out puertoUdp);
            int.TryParse(txtPuertoTcp.Text.Trim(), out puertoTcp);
            byte[] datos = Encoding.UTF8.GetBytes("CONNECT:" + puertoTcp);

            if (udp == null) { udp = new UdpClient(); udp.EnableBroadcast = true; }

            // envio a demanda: 3 repeticiones por si se pierde algun datagrama UDP
            for (int rep = 0; rep < 3; rep++)
            {
                if (chkBroadcast.Checked)
                    try { udp.Send(datos, datos.Length, new IPEndPoint(IPAddress.Broadcast, puertoUdp)); } catch { }

                string[] lineas = txtIPs.Text.Replace("\r", "").Split('\n');
                foreach (string ln in lineas)
                {
                    string ip = ln.Trim();
                    if (ip.Length == 0) continue;
                    try { udp.Send(datos, datos.Length, ip, puertoUdp); } catch { }
                }
            }
            lblEstado.Text = "Invitacion enviada. Esperando que los clientes se conecten...";
        }
        catch { }
    }

    // ==========================
    // Refresco del tablero
    // ==========================
    // Fila calculada (una por registro/usuario) lista para filtrar, ordenar y agregar.
    class Vista
    {
        public Registro R; public Fuente A;
        public int TotalDia, Escaneando, Est, IdleSeg;
        public double Cpm, Seg;
        public bool Conectado, Presente, HayTrab, Trabajando;
        public string Estado;
    }

    static Color ColorEstado(string e)
    {
        if (e == "Trabajando") return Color.FromArgb(30, 160, 30);   // verde
        if (e == "Inactivo") return Color.FromArgb(210, 140, 0);     // ambar
        if (e == "Vacia") return Color.FromArgb(150, 150, 150);      // gris
        return Color.FromArgb(200, 40, 40);                          // rojo (desconectado)
    }

    void RefrescarUI()
    {
        List<Registro> lista;
        lock (lockDatos) { lista = new List<Registro>(registros.Values); }

        ActualizarComboId(lista);

        DateTime ahora = DateTime.Now;

        // 1) calcular estado y metricas de cada registro
        List<Vista> vistas = new List<Vista>();
        foreach (Registro r in lista)
        {
            Fuente a = r.Activa();
            if (a == null) continue;

            int hIni; int[] hc; double[] hcpm; int[] hest;
            r.Combinar(out hIni, out hc, out hcpm, out hest);
            int totalDia = 0; foreach (int v in hc) totalDia += v;
            int nowIdx = ahora.Hour - hIni;
            int esc = (nowIdx >= 0 && nowIdx < hc.Length) ? hc[nowIdx] : 0;
            int activaTotal = 0; foreach (int v in a.Hist) activaTotal += v;

            Vista v2 = new Vista();
            v2.R = r; v2.A = a;
            v2.TotalDia = totalDia;
            v2.Escaneando = esc;
            v2.Cpm = a.Cpm;
            v2.Est = totalDia - activaTotal + a.Est;
            v2.Seg = (ahora - r.UltimoLatido()).TotalSeconds;
            v2.Conectado = v2.Seg <= CONECTADO_SEG;
            v2.Presente = a.Pres;
            v2.IdleSeg = a.Idle;
            // hay trabajador si hay un USER logueado en Edge, o si hubo/hay actividad
            v2.HayTrab = (r.User.Length > 0) || totalDia > 0 || a.Cpm > 0;
            // trabajando = conectado, presente y produciendo ahora
            v2.Trabajando = v2.Conectado && a.Pres && (a.Cpm > 0 || esc > 0);
            if (!v2.Conectado) v2.Estado = "Desconectado";
            else if (v2.Trabajando) v2.Estado = "Trabajando";
            else if (v2.HayTrab) v2.Estado = "Inactivo";
            else v2.Estado = "Vacia";
            vistas.Add(v2);
        }

        // 2) filas de la grilla = filtro por area + filtro por estado
        List<Vista> fil = new List<Vista>();
        foreach (Vista v in vistas)
        {
            bool areaOk = (areaMostrar == "Todos" || string.Equals(v.A.Modo, areaMostrar, StringComparison.OrdinalIgnoreCase));
            if (areaOk && PasaEstado(v)) fil.Add(v);
        }
        fil.Sort(delegate(Vista a, Vista b) { return b.TotalDia.CompareTo(a.TotalDia); });

        // 3) render de la grilla
        grid.SuspendLayout();
        grid.Rows.Clear();
        foreach (Vista v in fil)
        {
            string presencia = (v.Presente ? "Si" : "No") + " (" + FmtIdle(v.IdleSeg) + ")";
            string senal = ((char)0x25CF).ToString() + "  " + ((int)v.Seg) + "s";
            int fila = grid.Rows.Add(NombreDe(v.R), v.R.User, v.A.Modo, v.Estado, v.Escaneando.ToString(),
                v.Cpm.ToString("0.0"), v.Est.ToString(), v.TotalDia.ToString(), presencia, senal);
            grid.Rows[fila].Tag = v.R.Clave;
            Color dot = v.Conectado ? Color.FromArgb(30, 160, 30) : Color.FromArgb(200, 40, 40);
            grid.Rows[fila].Cells["Ult"].Style.ForeColor = dot;
            grid.Rows[fila].Cells["Ult"].Style.SelectionForeColor = dot;
            Color ce = ColorEstado(v.Estado);
            grid.Rows[fila].Cells["Estado"].Style.ForeColor = ce;
            grid.Rows[fila].Cells["Estado"].Style.SelectionForeColor = ce;
        }
        grid.ResumeLayout();

        // 4) metricas globales DIVIDIDAS POR AREA (respetan el filtro de estado, no el de area)
        AreaAcc retail = new AreaAcc();
        AreaAcc ecom = new AreaAcc();
        foreach (Vista v in vistas)
        {
            if (!PasaEstado(v)) continue;
            if (string.Equals(v.A.Modo, "Retail", StringComparison.OrdinalIgnoreCase)) retail.Add(v);
            else if (string.Equals(v.A.Modo, "ECOM", StringComparison.OrdinalIgnoreCase)) ecom.Add(v);
        }
        lblTot.Text = retail.Linea("RETAIL") + "\n" + ecom.Linea("ECOM ");
    }

    bool PasaEstado(Vista v)
    {
        switch (estadoMostrar)
        {
            case "Trabajando":      return v.Trabajando;
            case "Inactivos":       return v.Estado == "Inactivo";
            case "Sin trabajador":  return v.Estado == "Vacia";
            case "Desconectados":   return !v.Conectado;
            case "Con trabajador":  return v.HayTrab;
            default:                return true; // Todos
        }
    }

    // Acumulador de metricas de un area para la barra inferior.
    class AreaAcc
    {
        public int Pers, Trab, Total, Esc, Est, Act;
        public double CpmSum;
        public void Add(Vista v)
        {
            Pers++;
            if (v.Trabajando) Trab++;
            Total += v.TotalDia; Esc += v.Escaneando; Est += v.Est;
            if (v.Cpm > 0) { CpmSum += v.Cpm; Act++; }
        }
        public string Linea(string nombre)
        {
            double prom = Act > 0 ? CpmSum / Act : 0;
            return nombre + "   Trab " + Trab + "/" + Pers + "   Total " + Total +
                "   Escan " + Esc + "   CPMprom " + prom.ToString("0.0") +
                "   CPMtot " + CpmSum.ToString("0.0") + "   Est " + Est;
        }
    }

    void ActualizarComboId(List<Registro> lista)
    {
        List<string> actuales = new List<string>();
        foreach (Registro r in lista) { string id = Identidad(r); if (!actuales.Contains(id)) actuales.Add(id); }
        actuales.Sort();

        bool igual = (cboIP.Items.Count == actuales.Count);
        if (igual)
            foreach (object o in cboIP.Items) if (!actuales.Contains((string)o)) { igual = false; break; }

        if (!igual)
        {
            string sel = cboIP.SelectedItem as string;
            cboIP.Items.Clear();
            foreach (string id in actuales) cboIP.Items.Add(id);
            if (sel != null && actuales.Contains(sel)) cboIP.SelectedItem = sel;
        }
    }

    string NombreDe(Registro r)
    {
        lock (lockDatos) { return NombreDeSinLock(r); }
    }

    // resuelve: nombre manual -> bd.md (por USER) -> numero USER -> maquina/IP
    string NombreDeSinLock(Registro r)
    {
        string id = Identidad(r);
        string n;
        if (nombres.TryGetValue(id, out n) && n.Trim().Length > 0) return n;
        if (!string.IsNullOrEmpty(r.User))
        {
            string nm;
            if (usuariosDb.TryGetValue(r.User, out nm) && nm.Trim().Length > 0) return nm;
            return r.User;
        }
        Fuente a = r.Activa();
        if (a != null && !string.IsNullOrEmpty(a.MID)) return a.MID + " (" + a.IP + ")";
        return r.Clave;
    }

    string FmtIdle(int seg)
    {
        if (seg < 0) seg = 0;
        if (seg < 60) return seg + "s";
        int m = seg / 60; int s = seg % 60;
        return m + "m " + s + "s";
    }

