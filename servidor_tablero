    // ==========================
    // Base de datos de usuarios (bd.md): "<id><espacios/tab><nombre>" por linea
    // ==========================
    void CargarUsuarios()
    {
        try
        {
            // 1) base embebida (o descargada) pasada desde PowerShell
            if (!string.IsNullOrEmpty(UsuariosTexto))
                foreach (string ln in UsuariosTexto.Replace("\r", "").Split('\n')) ParseUsuarioLinea(ln);
            // 2) archivo local bd.md (extiende / sobreescribe lo embebido)
            if (File.Exists(ArchUsuarios))
                foreach (string ln in File.ReadAllLines(ArchUsuarios, Encoding.UTF8)) ParseUsuarioLinea(ln);
            lblEstado.Text = "Usuarios cargados: " + usuariosDb.Count;
        }
        catch { }
    }

    void ParseUsuarioLinea(string ln)
    {
        string s = ln.Trim();
        if (s.Length == 0 || s.StartsWith("#")) return;
        Match m = Regex.Match(s, @"^(\S+)\s+(.+)$");
        if (!m.Success) return;
        string id = m.Groups[1].Value.Trim();
        string nombre = m.Groups[2].Value.Trim();
        if (id.Length > 0) usuariosDb[id] = nombre;
    }

    // ==========================
    // Registro del dia (CSV) - por usuario, por hora
    // ==========================
    void GuardarLog(bool avisar)
    {
        try
        {
            Directory.CreateDirectory(CarpetaBase);
            List<Registro> lista;
            lock (lockDatos) { lista = new List<Registro>(registros.Values); }

            List<string> ls = new List<string>();
            ls.Add("Fecha,User,Nombre,Area,Hora,Conteo,CPM,Estimado");

            string fecha = DateTime.Now.ToString("yyyy-MM-dd");
            foreach (Registro r in lista)
            {
                Fuente a = r.Activa();
                if (a == null) continue;
                string nombre = NombreDe(r).Replace(",", " ");
                int hIni; int[] cnt; double[] cpm; int[] est;
                r.Combinar(out hIni, out cnt, out cpm, out est);
                for (int i = 0; i < cnt.Length; i++)
                {
                    int hora = hIni + i;
                    double cp = (i < cpm.Length) ? cpm[i] : 0;
                    int e = (i < est.Length) ? est[i] : 0;
                    ls.Add(fecha + "," + r.User + "," + nombre + "," + a.Modo + "," + hora + "," +
                        cnt[i] + "," + cp.ToString("0.00", CultureInfo.InvariantCulture) + "," + e);
                }
            }
            File.WriteAllLines(ArchLog, ls.ToArray());
            if (avisar) MessageBox.Show("Exportado a:\n" + ArchLog, "Exportar", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }
        catch (Exception ex) { if (avisar) MessageBox.Show("Error al exportar:\n" + ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error); }
    }

