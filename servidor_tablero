$BD_URL = ''   # ej: 'https://raw.githubusercontent.com/garfield310798-cyber/aaa/main/bd.md'

$bdTexto = $bdEmbebida
if ($BD_URL -ne '') {
    try {
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        $desc = (New-Object Net.WebClient).DownloadString($BD_URL)
        if ($desc -and $desc.Trim().Length -gt 0) { $bdTexto = $desc }
    } catch { }
}

[ServidorTablero]::UsuariosTexto = $bdTexto
