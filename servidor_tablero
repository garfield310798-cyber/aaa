// Una fuente = una maquina/sesion que reporta para un usuario.
public class Fuente
{
    public string MID = "";
    public string IP = "";
    public string Modo = "Retail";
    public int Cnt;
    public double Cpm;
    public int Est;
    public int Hora;
    public int HIni = 6;
    public int[] Hist = new int[0];
    public double[] HistCpm = new double[0];
    public int[] HistEst = new int[0];
    public int Idle;
    public bool Pres = true;
    public DateTime LastSeen = DateTime.Now;
}

// Registro agregado POR USUARIO (o por maquina si aun no se detecto el USER).
public class Registro
{
    public string Clave = "";  // "U:<user>" | "M:<mid>" | "IP:<ip>"
    public string User = "";
    public Dictionary<string, Fuente> Fuentes = new Dictionary<string, Fuente>(); // MID -> fuente
    public SortedDictionary<string, double> MCpm = new SortedDictionary<string, double>(); // HH:mm -> CPM
    public SortedDictionary<string, int> MIdle = new SortedDictionary<string, int>();       // HH:mm -> inactividad

    public Fuente Activa()
    {
        Fuente best = null;
        foreach (Fuente f in Fuentes.Values)
            if (best == null || f.LastSeen > best.LastSeen) best = f;
        return best;
    }

    public DateTime UltimoLatido()
    {
        DateTime dt = DateTime.MinValue;
        foreach (Fuente f in Fuentes.Values) if (f.LastSeen > dt) dt = f.LastSeen;
        return dt;
    }

    // Combina (suma por hora absoluta) el historial de todas las maquinas del usuario.
    public void Combinar(out int hIni, out int[] cnt, out double[] cpm, out int[] est)
    {
        int minH = int.MaxValue, maxH = int.MinValue;
        foreach (Fuente f in Fuentes.Values)
        {
            if (f.Hist.Length == 0) continue;
            if (f.HIni < minH) minH = f.HIni;
            int last = f.HIni + f.Hist.Length - 1;
            if (last > maxH) maxH = last;
        }
        if (minH == int.MaxValue) { hIni = 6; cnt = new int[0]; cpm = new double[0]; est = new int[0]; return; }
        int len = maxH - minH + 1;
        int[] c = new int[len]; double[] p = new double[len]; int[] e = new int[len];
        foreach (Fuente f in Fuentes.Values)
        {
            int off = f.HIni - minH;
            for (int i = 0; i < f.Hist.Length; i++)
            {
                int idx = off + i;
                if (idx < 0 || idx >= len) continue;
                c[idx] += f.Hist[i];
                if (i < f.HistCpm.Length && f.HistCpm[i] > p[idx]) p[idx] = f.HistCpm[i]; // CPM: el mayor de la hora
                if (i < f.HistEst.Length) e[idx] += f.HistEst[i];
            }
        }
        hIni = minH; cnt = c; cpm = p; est = e;
    }

    public int TotalDia()
    {
        int hIni; int[] c; double[] p; int[] e;
        Combinar(out hIni, out c, out p, out e);
        int t = 0; foreach (int v in c) t += v; return t;
    }
}

