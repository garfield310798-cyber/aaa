    // ==========================
    // Servidor TCP
    // ==========================
    void IniciarServidor()
    {
        try
        {
            int.TryParse(txtPuertoTcp.Text.Trim(), out puertoTcp);
            listener = new TcpListener(IPAddress.Any, puertoTcp);
            listener.Start();
            listener.BeginAcceptTcpClient(OnClienteConectado, null);
            lblEstado.Text = "Escuchando TCP " + puertoTcp + "  |  IP: " + IPsLocales();
        }
        catch (Exception ex) { lblEstado.Text = "Error servidor: " + ex.Message; }
    }

    string IPsLocales()
    {
        try
        {
            string r = "";
            foreach (IPAddress a in Dns.GetHostAddresses(Dns.GetHostName()))
                if (a.AddressFamily == AddressFamily.InterNetwork) r += a.ToString() + "  ";
            return r.Trim();
        }
        catch { return ""; }
    }

    void OnClienteConectado(IAsyncResult ar)
    {
        TcpClient cli;
        try { cli = listener.EndAcceptTcpClient(ar); }
        catch { return; }
        finally { try { listener.BeginAcceptTcpClient(OnClienteConectado, null); } catch { } }

        string ip = ((IPEndPoint)cli.Client.RemoteEndPoint).Address.ToString();
        byte[] buffer = new byte[8192];
        object[] estado = new object[] { cli, buffer, ip, new StringBuilder() };
        try { cli.GetStream().BeginRead(buffer, 0, buffer.Length, OnDatos, estado); } catch { }
    }

    void OnDatos(IAsyncResult ar)
    {
        object[] estado = (object[])ar.AsyncState;
        TcpClient cli = (TcpClient)estado[0];
        byte[] buffer = (byte[])estado[1];
        string ip = (string)estado[2];
        StringBuilder acum = (StringBuilder)estado[3];

        int n;
        try { n = cli.GetStream().EndRead(ar); } catch { n = 0; }
        if (n <= 0) { try { cli.Close(); } catch { } return; }

        acum.Append(Encoding.UTF8.GetString(buffer, 0, n));
        string todo = acum.ToString();
        int idx;
        while ((idx = todo.IndexOf('\n')) >= 0)
        {
            string linea = todo.Substring(0, idx).Trim();
            todo = todo.Substring(idx + 1);
            if (linea.Length > 0) ProcesarLinea(ip, linea);
        }
        acum.Length = 0; acum.Append(todo);

        try { cli.GetStream().BeginRead(buffer, 0, buffer.Length, OnDatos, estado); }
        catch { try { cli.Close(); } catch { } }
    }

    void ProcesarLinea(string ip, string linea)
    {
        if (linea.StartsWith("SAMP")) { ProcesarSample(ip, linea); return; }
        if (!linea.StartsWith("REP")) return;

        // 1) parsear a variables temporales
        string user = "", mid = "", modo = "Retail";
        int cnt = 0, est = 0, hora = 0, hini = 6, idle = 0; double cpm = 0; bool pres = true;
        int[] hist = new int[0]; double[] hcpm = new double[0]; int[] hest = new int[0];

        string[] partes = linea.Split('|');
        foreach (string parte in partes)
        {
            int eq = parte.IndexOf('=');
            if (eq <= 0) continue;
            string k = parte.Substring(0, eq);
            string v = parte.Substring(eq + 1);
            switch (k)
            {
                case "USER": user = v.Trim(); break;
                case "MID": mid = v; break;
                case "MODO": modo = v; break;
                case "CNT": int.TryParse(v, out cnt); break;
                case "CPM": double.TryParse(v, NumberStyles.Any, CultureInfo.InvariantCulture, out cpm); break;
                case "EST": int.TryParse(v, out est); break;
                case "HR": int.TryParse(v, out hora); break;
                case "HINI": int.TryParse(v, out hini); break;
                case "HIST": hist = ParseInts(v); break;
                case "HCPM": hcpm = ParseDoubles(v); break;
                case "HEST": hest = ParseInts(v); break;
                case "IDLE": int.TryParse(v, out idle); break;
                case "PRES": pres = (v == "1"); break;
            }
        }

        // 2) guardar bajo la clave del usuario
        string clave = Clave(user, mid, ip);
        string fkey = (mid.Length > 0) ? mid : ip;
        lock (lockDatos)
        {
            Registro r;
            if (!registros.TryGetValue(clave, out r)) { r = new Registro(); r.Clave = clave; registros[clave] = r; }
            if (user.Length > 0) r.User = user;

            Fuente f;
            if (!r.Fuentes.TryGetValue(fkey, out f)) { f = new Fuente(); r.Fuentes[fkey] = f; }
            f.MID = mid; f.IP = ip; f.Modo = modo;
            f.Cnt = cnt; f.Cpm = cpm; f.Est = est; f.Hora = hora; f.HIni = hini;
            f.Hist = hist; f.HistCpm = hcpm; f.HistEst = hest;
            f.Idle = idle; f.Pres = pres; f.LastSeen = DateTime.Now;

            claveDeIp[ip] = clave;

            // si ya conocemos el USER, absorber el registro anonimo de esa maquina (si existia)
            if (user.Length > 0 && mid.Length > 0)
            {
                string anon = "M:" + mid;
                Registro ra;
                if (anon != clave && registros.TryGetValue(anon, out ra))
                {
                    foreach (KeyValuePair<string, double> kv in ra.MCpm) r.MCpm[kv.Key] = kv.Value;
                    foreach (KeyValuePair<string, int> kv in ra.MIdle) r.MIdle[kv.Key] = kv.Value;
                    registros.Remove(anon);
                }
            }
        }
    }

    int[] ParseInts(string v)
    {
        string[] hs = v.Split(',');
        int[] arr = new int[hs.Length];
        for (int i = 0; i < hs.Length; i++) { int x; int.TryParse(hs[i], out x); arr[i] = x; }
        return arr;
    }
    double[] ParseDoubles(string v)
    {
        string[] cs = v.Split(',');
        double[] arr = new double[cs.Length];
        for (int i = 0; i < cs.Length; i++) { double x; double.TryParse(cs[i], NumberStyles.Any, CultureInfo.InvariantCulture, out x); arr[i] = x; }
        return arr;
    }

    // ==========================
    // Muestras cada 2 min (CPM e inactividad) -> agregadas por usuario
    // ==========================
    void ProcesarSample(string ip, string linea)
    {
        string user = "", mid = "", modo = "", t = "", cpm = "0", idle = "0";
        string[] partes = linea.Split('|');
        foreach (string parte in partes)
        {
            int eq = parte.IndexOf('=');
            if (eq <= 0) continue;
            string k = parte.Substring(0, eq);
            string v = parte.Substring(eq + 1);
            switch (k)
            {
                case "USER": user = v.Trim(); break;
                case "MID": mid = v; break;
                case "MODO": modo = v; break;
                case "T": t = v; break;
                case "CPM": cpm = v; break;
                case "IDLE": idle = v; break;
            }
        }
        if (t.Length == 0) return;

        string identidad, nombre, area = modo;
        lock (lockDatos)
        {
            // clave: por USER si viene; si no, seguir la clave que uso el REP de esta IP
            string clave;
            if (user.Length > 0) clave = Clave(user, mid, ip);
            else if (!claveDeIp.TryGetValue(ip, out clave)) clave = Clave("", mid, ip);

            Registro r;
            if (!registros.TryGetValue(clave, out r)) { r = new Registro(); r.Clave = clave; registros[clave] = r; }
            if (user.Length > 0) r.User = user;

            double cp; double.TryParse(cpm, NumberStyles.Any, CultureInfo.InvariantCulture, out cp);
            int id; int.TryParse(idle, out id);
            r.MCpm[t] = cp;
            r.MIdle[t] = id;

            if (modo.Length > 0)
            {
                string fkey = (mid.Length > 0) ? mid : ip;
                Fuente f;
                if (r.Fuentes.TryGetValue(fkey, out f)) f.Modo = modo;
            }
            if (area.Length == 0) { Fuente a = r.Activa(); if (a != null) area = a.Modo; }

            identidad = Identidad(r);
            nombre = NombreDeSinLock(r);
        }
        GuardarMuestra(identidad, nombre, area, ip, t, cpm, idle);
    }

    void GuardarMuestra(string identidad, string nombre, string area, string ip, string hora, string cpm, string idle)
    {
        string key = identidad + "|" + hora;
        lock (lockArchivo)
        {
            if (muestrasVistas.ContainsKey(key)) return;
            try
            {
                Directory.CreateDirectory(CarpetaBase);
                bool existe = File.Exists(ArchMuestras);
                using (StreamWriter w = new StreamWriter(ArchMuestras, true))
                {
                    if (!existe) w.WriteLine("Fecha,Hora,User,Nombre,Area,IP,CPM,InactivoSeg");
                    w.WriteLine(DateTime.Now.ToString("yyyy-MM-dd") + "," + hora + "," + identidad + "," +
                        nombre.Replace(",", " ") + "," + area + "," + ip + "," + cpm + "," + idle);
                }
                muestrasVistas[key] = true; // marcar solo si se escribio bien
